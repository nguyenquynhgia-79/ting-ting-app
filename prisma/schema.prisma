generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  username         String         @unique
  email            String         @unique
  full_name        String?
  phone_number     String?        @unique
  password_hash    String
  avatar_url       String?
  status           UserStatus     @default(require_password_change)
  role             Role           @default(USER)
  created_at       DateTime       @default(now())
  bank_name        String?
  account_number   String?
  account_name     String?
  auditLogs        AuditLog[]
  splits           ExpenseSplit[]
  expensesPaid     Expense[]      @relation("PaidBy")
  memberships      GroupMember[]
  createdGroups    Group[]        @relation("CreatedBy")
  notifications    Notification[]
  receivedPayments Payment[]      @relation("ReceivedBy")
  sentPayments     Payment[]      @relation("SentBy")
  subscription     Subscription?
  trips            Trip[]

  @@map("users")
}

model Group {
  id          String        @id @default(uuid())
  name        String
  invite_code String        @unique
  qr_code_url String?
  created_by  String
  created_at  DateTime      @default(now())
  deleted_at  DateTime?
  expenses    Expense[]
  members     GroupMember[]
  creator     User          @relation("CreatedBy", fields: [created_by], references: [id])
  payments    Payment[]
  trips       Trip[]

  @@map("groups")
}

model GroupMember {
  group_id  String
  user_id   String
  balance   Decimal  @default(0)
  joined_at DateTime @default(now())
  group     Group    @relation(fields: [group_id], references: [id])
  user      User     @relation(fields: [user_id], references: [id])

  @@id([group_id, user_id])
  @@map("group_members")
}

model Expense {
  id                String         @id @default(uuid())
  group_id          String
  payer_id          String
  amount            Decimal
  description       String?
  receipt_image_url String?
  proof_url         String?
  split_type        SplitType      @default(EQUAL)
  created_at        DateTime       @default(now())
  splits            ExpenseSplit[]
  group             Group          @relation(fields: [group_id], references: [id])
  payer             User           @relation("PaidBy", fields: [payer_id], references: [id])

  @@map("expenses")
}

model ExpenseSplit {
  id          String  @id @default(uuid())
  expense_id  String
  user_id     String
  amount_owed Decimal
  expense     Expense @relation(fields: [expense_id], references: [id])
  user        User    @relation(fields: [user_id], references: [id])

  @@map("expense_splits")
}

model Payment {
  id         String        @id @default(uuid())
  group_id   String
  payer_id   String
  payee_id   String
  amount     Decimal
  status     PaymentStatus @default(PENDING)
  created_at DateTime      @default(now())
  group      Group         @relation(fields: [group_id], references: [id])
  payee      User          @relation("ReceivedBy", fields: [payee_id], references: [id])
  payer      User          @relation("SentBy", fields: [payer_id], references: [id])

  @@map("payments")
}

model Notification {
  id                String   @id @default(uuid())
  user_id           String
  type              String
  title             String
  message           String
  is_read           Boolean  @default(false)
  related_entity_id String?
  created_at        DateTime @default(now())
  user              User     @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model TokenBlacklist {
  id         String   @id @default(uuid())
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("token_blacklist")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String?
  details    String?
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

enum UserStatus {
  require_password_change
  active
  inactive
  blocked
}

enum Role {
  USER
  ADMIN
}

enum SplitType {
  EQUAL
  CUSTOM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum TripMode {
  AI
  MANUAL
}

enum TripStatus {
  DRAFT
  PUBLISHED
}

enum TripSource {
  AI
  MANUAL
}

model Subscription {
  id         String           @id @default(uuid())
  user_id    String           @unique
  plan       SubscriptionPlan @default(FREE)
  started_at DateTime         @default(now())
  expires_at DateTime?
  user       User             @relation(fields: [user_id], references: [id])

  @@map("subscriptions")
}

model Trip {
  id              String     @id @default(uuid())
  group_id        String
  created_by      String
  name            String
  destination     String
  destination_lat Float?
  destination_lng Float?
  start_date      DateTime
  end_date        DateTime
  mode            TripMode   @default(MANUAL)
  status          TripStatus @default(DRAFT)
  created_at      DateTime   @default(now())

  group      Group           @relation(fields: [group_id], references: [id])
  creator    User            @relation(fields: [created_by], references: [id])
  preference TripPreference?
  stops      TripStop[]

  @@map("trips")
}

model TripPreference {
  id                String  @id @default(uuid())
  trip_id           String  @unique
  num_people        Int
  budget_per_person Decimal
  preferences       String // JSON string
  travel_style      String
  radius_km         Int
  trip              Trip    @relation(fields: [trip_id], references: [id])

  @@map("trip_preferences")
}

model TripStop {
  id              String     @id @default(uuid())
  trip_id         String
  order           Int
  name            String
  address         String?
  lat             Float?
  lng             Float?
  type            String?
  scheduled_time  String?
  photo_url       String?
  rating          Float?
  description     String?
  google_place_id String?
  source          TripSource @default(MANUAL)
  trip            Trip       @relation(fields: [trip_id], references: [id])

  @@map("trip_stops")
}
